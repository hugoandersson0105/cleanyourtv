<?xml version="1.0" encoding="utf-8"?>
<!-- Control Center panel: dark frosted glass, a soft top sheen and a hairline edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#EB1E1F26" android:endColor="#F5090A0E" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#14FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
