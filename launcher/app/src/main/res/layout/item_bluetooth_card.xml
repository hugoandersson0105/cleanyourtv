<?xml version="1.0" encoding="utf-8"?>
<!-- The Bluetooth card: one row per paired device with its connection and battery. OK opens Bluetooth settings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/control_tile_bg"
    android:focusable="true"
    android:clickable="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/arimo_medium"
        android:text="@string/panel_bluetooth"
        android:textColor="#F2FFFFFF"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/btDevices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />
</LinearLayout>
