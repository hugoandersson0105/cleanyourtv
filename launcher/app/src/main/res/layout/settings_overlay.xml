<?xml version="1.0" encoding="utf-8"?>
<!-- Control Center style panel: a floating card at the top right, drawn over the current screen (SettingsOverlay). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#26000000">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="332dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/panel_glass_bg"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <!-- Time and date, small, top left -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arimo_light"
                android:includeFontPadding="false"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/ampm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/arimo_medium"
                android:textAllCaps="true"
                android:textColor="#99FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="4dp"
            android:fontFamily="@font/arimo_medium"
            android:letterSpacing="0.1"
            android:singleLine="true"
            android:ellipsize="end"
            android:textAllCaps="true"
            android:textColor="#80FFFFFF"
            android:textSize="10sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false">

                <!-- Network tile (full width) -->
                <LinearLayout
                    android:id="@+id/netSlot"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Bluetooth devices and the remote's battery -->
                <LinearLayout
                    android:id="@+id/btSlot"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone" />

                <!-- Storage and memory, as info tiles -->
                <LinearLayout
                    android:id="@+id/infoRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-5dp"
                    android:layout_marginEnd="-5dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />

                <!-- Settings tiles, two to a row -->
                <LinearLayout
                    android:id="@+id/tileGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-5dp"
                    android:layout_marginEnd="-5dp"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingStart="4dp"
                    android:fontFamily="@font/arimo_medium"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true"
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp"
                    android:text="@string/panel_notifications" />

                <TextView
                    android:id="@+id/noNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingStart="4dp"
                    android:fontFamily="@font/arimo_regular"
                    android:textColor="#66FFFFFF"
                    android:textSize="11sp"
                    android:text="@string/panel_no_notifications" />

                <LinearLayout
                    android:id="@+id/notifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="4dp"
            android:fontFamily="@font/arimo_regular"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#55FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
